#!/bin/bash

AISDECODE="/home/preeve/.local/bin/ais-decode -j"
BASENAME="/usr/bin/basename"
BC=/usr/bin/bc
CAT=/usr/bin/cat
CURL=/usr/bin/curl
GREP=/usr/bin/grep
JQ=/usr/bin/jq
MIMECONSTRUCT=/usr/bin/mime-construct
REALPATH=/usr/bin/realpath
SED=/usr/bin/sed
SOCAT=/usr/bin/socat
TAC=/usr/bin/tac
TS="/usr/bin/ts %Y%m%dT%H%M%S"

MY_NAME=$(${BASENAME} ${0})

ATTACHMENTS=("http://192.168.1.1:3000/signalk/v1/api/vessels/self/tanks/;tanks" "http://192.168.1.1:3000/signalk/v1/api/vessels/self/electrical/batteries/;batteries" "http://192.168.1.1:3000/signalk/v1/api/vessels/self/electrical/solar/;solar")
CONFIGURE=no
DEBUG=no
PORT=12345
RECIPIENT=wordpress@pdjr.eu
VERBOSE=no
ACCURACY=4

while [ "${1}" != "" ] ; do
  case ${1} in
    --attachment | -a)
      shift
      ATTACHMENTS+=(${1})
      ;;
    --configure | -c)
      CONFIGURE=yes
      ;;
    --debug | -d)
      DEBUG=yes
      ;;
    --help | -h)
      ${TAC} ${0} | ${SED} '/^$/,$d' | ${TAC} | cut -c 3-
      exit 0
      ;;
    --port | -p)
      shift
      PORT=${1}
      ;;
    --recipient | -r)
      shift
      RECIPIENT=${1}
      ;;
    --verbose | -v)
      VERBOSE=yes
      ;;
    *)
      echo "${MY_NAME}[$$]: bad option (${1})"
      exit 1
      ;;
  esac
  shift
done

#######################################################################
# Configuration mode (invoked by -c option)
#
if [[ "${CONFIGURE}" == "yes" ]] ; then
  if [[ ${EUID} -eq 0 ]] ; then
    attachments=$( IFS=$'\n'; echo "${ATTACHMENTS[*]}" )
    attachments=$(echo ${attachments} | sed -e 's/[\/&]/\\&/g')
    ${SED} -i "s/^ATTACHMENTS=.*$/ATTACHMENTS=(${attachments})/" $(${REALPATH} ${0})
    ${SED} -i "s/^PORT=.*$/PORT=${PORT}/" $(${REALPATH} ${0})
    ${SED} -i "s/^RECIPIENT=.*$/RECIPIENT=${RECIPIENT}/" $(${REALPATH} ${0})
  else
    echo "${MY_NAME}[$$]: sorry, the -c option is only available to root."
    exit 1
  fi
  echo "${MY_NAME}[$$]: current configuration:"
  echo "  ATTACHMENTS = ${ATTACHMENTS[@]}"
  echo "  PORT = ${PORT}"
  echo "  RECIPIENT = ${RECIPIENT}"
  exit 0
fi

#######################################################################
# Start server
#
echo "${MY_NAME}[$$]: listening on port ${PORT}, sending updates to <${RECIPIENT}>"

LOG=()
LOG_DAY=`date +%j`
LOG_PRETTY_DAY="$(date '+%a %-d %B %Y')"
LOG_DATE="$(date '+%Y%m%d')"
LOG_MONTH="$(date '+%Y%m')"
LOG_YEAR="$(date '+%Y')"
LLAT=
LLON=
MSG_COUNT=0

${SOCAT} -u UDP-RECV:${PORT} STDOUT | while IFS= read -r line ; do
  MSG_COUNT=$((MSG_COUNT + 1))
  MSG_DAY=`date +%j`

  # If a new day, then send the consolidated log
  if ( [[ "${DEBUG}" == "yes" ]] && [[ ${MSG_COUNT} -eq 3 ]] ) || [[ "${MSG_DAY}" != "${LOG_DAY}" ]] ; then
    WP_TAGS="ais,day,${LOG_DATE},${LOG_MONTH},${LOG_YEAR}"

    EMAIL_SUBJECT="${LOG_PRETTY_DAY}"
    EMAIL_BODY=$(printf "date: ${LOG_DATE}\ntags: ${WP_TAGS},\n\n")

    # Generate log file attachment
    LOG_ATTACHMENT_="/tmp/${LOG_DATE}.ais"
    echo ${LOG[@]} > "${LOG_ATTACHMENT_}"
    LOG_ATTACHMENT_CLAUSE="--file-attach ${LOG_ATTACHMENT_}"

    echo "generating additonal attachments ${ATTACHMENTS[@]}"
    # Generate end-of-day file attachments
    if [[ ${#ATTACHMENTS[@]} -gt 0 ]] ; then
      for ((i = 0; i < ${#ATTACHMENTS[@]}; i++)) ; do
        if [[ "${ATTACHMENTS[${i}]}" =~ ^(http.*)\;(.*)$ ]] ; then
          url=${BASH_REMATCH[1]}
          ext=${BASH_REMATCH[2]}
          printf -v aname "/tmp/%s.%s" ${LOG_DATE} ${ext}
          ${CURL} -s -o "${aname}" "${url}"
        else
          aname=${ATTACHMENTS[${i}]}
        fi            
        if [ -e "${aname}" ] ; then
          LOG_ATTACHMENT_CLAUSE="${LOG_ATTACHMENT_CLAUSE} --file-attach ${aname}" ; 
        else
          echo "${MY_NAME}[$$]: skipping unavailable attachment (${ATTACHMENTS[${i}]})"
        fi
      done
    fi

    ${MIMECONSTRUCT} --to "${RECIPIENT}" --subject "${EMAIL_SUBJECT}" --encoding 8bit --string "${EMAIL_BODY}" ${LOG_ATTACHMENT_CLAUSE}
    
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: uploading log with ${LOG_ATTACHMENT_CLAUSE}"

    LOG=()
    LOG_DAY=${MSG_DAY}
    LOG_PRETTY_DAY="$(date '+%a %-d %B %Y')"
    LOG_DATE="$(date '+%Y%m%d')"
    LOG_MONTH="$(date '+%Y%m')"
    LOG_YEAR="$(date '+%Y')"
    MSG_COUNT=1
    LLAT=
    LLON=
  fi

  MSG_DAY_JSON=$(echo ${line} | ${AISDECODE})

  LAT=$(echo "${MSG_DAY_JSON}" | ${JQ} -r --argjson power $ACCURACY '.lat*pow(10;$power)|round/pow(10;$power)')
  LON=$(echo "${MSG_DAY_JSON}" | ${JQ} -r --argjson power $ACCURACY '.lon*pow(10;$power)|round/pow(10;$power)')

  if [[ "${LLAT}" != "${LAT}" ]] || [[ "${LLON}" != "${LON}" ]] ; then
    LOG+=("$(echo ${line} | ${TS})"$'\n')
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: saving ${line}"
  else
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: discarding duplicate position"
  fi

  LLAT=${LAT}
  LLON=${LON}
done

exit

# NAME
#   aislog-uploader - accumulate/upload AIS data to an email address.
#
# USAGE
#   usage: aislog-uploader -h
#   usage: aislog-uploader -c [-a attachment]... [-p port] [-r recipient]
#   usage: aislog-uploader [-a attachment]... [-d] [-p port] [-r recipient] [-v]
#
# DESCRIPTION
#   aislog-uploader is a server which listens on a UDP port for AIS
#   !AIVDM position reports. Consecutive reports which refer to the
#   same geographic location are discarded and all other messages are
#   timestamped and logged. At the end of each day the assembled log
#   is emailed to a specified recipient and a new log started for the
#   new day.
#
#   The programs maintains a persistent internal configuration which
#   can be displayed and set from the command line.
#
#   Once configured aislog-uploader is typically run as a service
#   under systemd.
#
# PROGRAM OPTIONS
#   The following options are available. 
#
#   --attachment filename
#   -a filename
#   --attachment url;ext
#   -a url;ext
#   specifies a resource identified by a filename or url that should be
#   attached to the log email when it is sent. A url is differentiated
#   from a filename by having the form 'http*' and When a url is used
#   (typically to reference an API) then ext must be supplied to
#   identify the type of the data returned by the API call. 
#
#   It is possible to use ext (and any extension embedded in filename)
#   to identify the logical content of the data being referenced,
#   leaving the final recipient of the attachment to handle downstream
#   processing.
#
#   --configure
#   -c
#   runs the program in configuration mode. On its own the switch
#   simply reports the program configuration. If used with any of
#   -a, -p or -r the root user can update the in-built program
#   configuration.
#
#   --debug
#   -d
#   engages debug mode in which the reporting email is sent after
#   receipt of every three AIS position reports (rather than at the
#   end of each day). 
#
#   --help
#   -h
#   prints (this) help information.
#
#   --port port
#   -p port
#   specifies the UDP port number on which the server should listen
#   for incoming position reports.
#
#   --recipient email-address
#   -r email-address
#   specifies the email-address of the recipient to which log reports
#   should be sent.
#
#   --verbose
#   -v
#   engages verbose mode in which diagnostic messages are printed to
#   standard output.
