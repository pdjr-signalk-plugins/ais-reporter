#!/bin/bash
# NAME
#   ais-log-uploader - accumulate/upload AIS data to an email address.
# USAGE
#   usage: ais-log-uploader -c [-a accuracy] [-e filename] [-m count] [-p port] [-r recipient]
#   usage: ais-log-uploader [-a accuracy] [-h] [-m count] [-p port] [-r recipient] [-v]
# DESCRIPTION
#   ais-log-uploader is a server which listens on a UDP port for AIS
#   !AIVDM position reports. Consecutive reports which refer to the
#   same geographic location are discarded and all other messages are
#   timestamped and logged. At the end of each day the assembled log
#   is emailed to a specified recipient and a new log started for the
#   new day.
#
#   The programs operation is defined by four properties which define
#   its behaviour.
#
#   ACCURACY is an integer value which specifies the number of
#   decimal places in latitude and longitude values which should be
#   considered significant when identifying duplicate position reports.
#   Default is 4. 
#
#   MESSAGES is an integer value which triggers mailing of the current
#   log after the specified number of UDP messages have been received
#   rather than at the end of the day. Useful for testing. Defaults to
#   0 (disabled).
#
#   FILENAME is a filename or URL which contains or returns a JSON text
#   object that is attached to the end-of-day email alongside the
#   assembled log.  
#
#   PORT is an integer value which specifies the UDP port on which the
#   program should listen for incoming AIS reports. Defaults to 12345.
#
#   RECIPIENT is an email address to which consolidated log data should
#   sent. Defaults to "someuser@somwhere.com" and must be set to an
#   appropriate value.
#
#   The program can be invoked in configuration mode which allows these
#   persistent configuration values to be displayed and updated.
#
#   Once configured ais-log-uploader is typically run as a service
#   under systemd.
# PROGRAM OPTIONS
#   The following options are available. 
#
#   -a introduces an integer which sets ACCURACY.
#
#   -c runs the program in configuration mode. On its own the switch
#      simply reports the program configuration. If used with any of
#      -a, -m, -p or -r the root user can update the in-built program
#      configuration.
#
#   -e introduces a filename which identifies an end-of-day attachment.
#
#   -h print (this) help information.
#
#   -m introduces an integer which sets MESSAGES.
#
#   -p introduces an integer which set PORT.
#
#   -r introduces an email address which sets RECIPIENT.
#
#   -v print diagnostics

AISDECODE="/home/preeve/.local/bin/ais-decode -j"
BASENAME="/usr/bin/basename"
BC=/usr/bin/bc
JQ=/usr/bin/jq
MIMECONSTRUCT=/usr/bin/mime-construct
REALPATH=/usr/bin/realpath
SED=/usr/bin/sed
SOCAT=/usr/bin/socat
TS="/usr/bin/ts %Y%m%dT%H%M%S"
WGET=/usr/bin/wget

MY_NAME=$(${BASENAME} ${0})
ACCURACY=4
CONFIGURE=no
FILENAME=https://192.168.1.5/signalk/v1/api/vessels/self/
MESSAGES=0
PORT=12345
RECIPIENT=wordpress@pdjr.eu
VERBOSE=no

while [ "${1}" != "" ] ; do
  case ${1} in
    -a)
      shift
      OPTION_ACCURACY=${1}
      ACCURACY=${1}
      ;;
    -c)
      OPTION_CONFIGURE=yes
      ;;
    -e)
      shift
      OPTION_FILENAME=${1}
      FILENAME=${1}
      ;;
    -h)
      ${SED} -e '/^$/,$d' ${0} | tail -n +2 | cut -c 3-
      exit 0
      ;;
    -m)
      shift
      OPTION_MESSAGES=${1}
      MESSAGES=${1}
      ;;
    -p)
      shift
      OPTION_PORT=${1}
      PORT=${1}
      ;;
    -r)
      shift
      OPTION_RECIPIENT=${1}
      RECIPIENT=${1}
      ;;
    -v)
      VERBOSE=yes
      ;;
    *)
      echo "syntax error"
      exit 1
      ;;
  esac
  shift
done

#######################################################################
# Configuration mode (invoked by -c option)
#
if [[ "${OPTION_CONFIGURE}" == "yes" ]] ; then
  if [ -v OPTION_ACCURACY ] || [ -v OPTION_MESSAGES ] || [ -v OPTION_PORT ] || [ -v OPTION_RECIPIENT ] ; then
    if [[ ${EUID} -eq 0 ]] ; then
      if [ -v OPTION_ACCURACY ] ; then
        ${SED} -i "s/^ACCURACY=.*$/ACCURACY=${OPTION_ACCURACY}/" $(${REALPATH} ${0})
      fi
      if [ -v OPTION_FILENAME ] ; then
        ${SED} -i "s/^FILENAME=.*$/FILENAME=${OPTION_FILENAME}/" $(${REALPATH} ${0})
      fi
      if [ -v OPTION_MESSAGES ] ; then
        ${SED} -i "s/^MESSAGES=.*$/MESSAGES=${OPTION_MESSAGES}/" $(${REALPATH} ${0})
      fi
      if [ -v OPTION_PORT ] ; then
        ${SED} -i "s/^PORT=.*$/PORT=${OPTION_PORT}/" $(${REALPATH} ${0})
	    fi
      if [ -v OPTION_RECIPIENT ] ; then
        ${SED} -i "s/^RECIPIENT=.*$/RECIPIENT=${OPTION_RECIPIENT}/" $(${REALPATH} ${0})
	    fi
      exec "$(${REALPATH} ${0})" "-c"
    else
      echo "${MY_NAME}[$$]: sorry, only root can do that"
      exit
    fi
  fi
  echo "${MY_NAME}[$$]: ACCURACY = ${ACCURACY}, FILENAME = ${FILENAME}, MESSAGES = ${MESSAGES}, PORT = ${PORT}, RECIPIENT = ${RECIPIENT}"
  exit
fi

#######################################################################
# Start server
#
echo "${MY_NAME}[$$]: listening on port ${PORT}, sending updates to <${RECIPIENT}>"

LOG=()
LOG_DAY=`date +%j`
LOG_PRETTY_DAY="$(date '+%a %-d %B %Y')"
LOG_DATE="$(date '+%Y%m%d')"
LOG_MONTH="$(date '+%Y%m')"
LOG_YEAR="$(date '+%Y')"
LLAT=
LLON=
MSG_COUNT=0

${SOCAT} -u UDP-RECV:${PORT} STDOUT | while IFS= read -r line ; do
  MSG_COUNT=$((MSG_COUNT + 1))
  MSG_DAY=`date +%j`

  # If a new day, then send the consolidated log
  if ( [[ ${MESSAGES} -ne 0 ]] && [[ ${MSG_COUNT} -gt ${MESSAGES} ]] ) || [[ "${MSG_DAY}" != "${LOG_DAY}" ]] ; then
    WP_TAGS="ais,day,${LOG_DATE},${LOG_MONTH},${LOG_YEAR}"

    EMAIL_SUBJECT="log: ${LOG_PRETTY_DAY}"
    EMAIL_BODY=$(printf "date: ${LOG_DATE}\ntags: ${WP_TAGS},\n\n")
		
    # Generate log file attachment
    LOG_ATTACHMENT_FILENAME="/tmp/${LOG_DATE}.ais"
    echo ${LOG[@]} > "${LOG_ATTACHMENT_FILENAME}"
    LOG_ATTACHMENT_CLAUSE="--file-attach ${LOG_ATTACHMENT_FILENAME}"

    # Generate end-of-day file attachment
    if [ "${FILENAME}" != "" ] ; then
      JSON_ATTACHMENT_FILENAME="/tmp/${LOG_DATE}.json"
      ${WGET} ${FILENAME} > "${JSON_ATTACHMENT_FILENAME}"
      JSON_ATTACHMENT_CLAUSE="--file-attach ${JSON_ATTACHMENT_FILENAME}"
    fi

    ${MIMECONSTRUCT} --to "${RECIPIENT}" --subject "${EMAIL_SUBJECT}" --encoding 8bit --string "${EMAIL_BODY}" ${LOG_ATTACHMENT_CLAUSE} ${JSON_ATTACHMENT_CLAUSE}
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: uploading log"

    LOG=()
    LOG_DAY=${MSG_DAY}
    LOG_PRETTY_DAY="$(date '+%a %-d %B %Y')"
    LOG_DATE="$(date '+%Y%m%d')"
    LOG_MONTH="$(date '+%Y%m')"
    LOG_YEAR="$(date '+%Y')"
    MSG_COUNT=0
    LLAT=
    LLON=
  fi

  MSG_DAY_JSON=$(echo ${line} | ${AISDECODE})

  LAT=$(echo "${MSG_DAY_JSON}" | ${JQ} -r --argjson power $ACCURACY '.lat*pow(10;$power)|round/pow(10;$power)')
  LON=$(echo "${MSG_DAY_JSON}" | ${JQ} -r --argjson power $ACCURACY '.lon*pow(10;$power)|round/pow(10;$power)')

  if [[ "${LLAT}" != "${LAT}" ]] || [[ "${LLON}" != "${LON}" ]] ; then
    LOG+=("$(echo ${line} | ${TS})"$'\n')
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: saving ${line}"
  else
    [[ "${VERBOSE}" == "yes" ]] && echo "${MY_NAME}[$$]: discarding duplicate position"
  fi

  LLAT=${LAT}
  LLON=${LON}
done

exit

